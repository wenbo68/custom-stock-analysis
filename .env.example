# leave blank if just using sqlite
DATABASE_URL=
# how many concurrent runs are allowed (extra runs will be queued)
MAX_CONCURRENT_RUNS=4
# the chat's context window, in tokens, for a model litellm's table does not know (default 128000; the chat fills at most half)
CHAT_CONTEXT_WINDOW=

# llm api key: this key and the 2 models below must all be from the same provider
LLM_API_KEY=
# main llm in litellm format
MAIN_LLM=
# sub llm in litellm format: for processing news articles; leave blank to use the main llm for all
SUB_LLM=

# for fundamentals report
SEC_EDGAR_USER_AGENT=your-name (your@email.com)
# for macro econ report
FRED_API_KEY=
# for company news report
FINNHUB_API_KEY=
# for world news report
ALPHAVANTAGE_API_KEY=
