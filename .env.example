# optional
# leave blank to just use sqlite (local db)
DATABASE_URL=
# how many concurrent runs are allowed (extra runs will be queued)
MAX_CONCURRENT_RUNS=4
# optional
# if you are using a model that litellm doesn't know, enter the model's context window here in tokens.
# if litellm cannot find your model and if this field is blank,
# the max context window will default to 128,000 tokens with half of that reserved for the LLM response
CHAT_CONTEXT_WINDOW=

# llm api key: this key and the 2 models below must all be from the same provider
LLM_API_KEY=
# main llm in litellm format
MAIN_LLM=
# optional
# sub llm in litellm format. this is only for processing news articles. leave blank to use the main llm for all
SUB_LLM=

# for fundamentals report
SEC_EDGAR_USER_AGENT=your-name (your@email.com)
# for macro econ report
FRED_API_KEY=
# for company news report
FINNHUB_API_KEY=
# backup for the newest US price bars
ALPHAVANTAGE_API_KEY=
