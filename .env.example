# Custom Stock Analysis (self-host) — configuration.
# Copy to .env and fill in what you use. Everything is optional except the
# LLM model and its key: without LITELLM_MODEL an analysis run refuses to
# start.

# ============================================================
# LLM (required)
# ============================================================
# Model name in litellm format, e.g. "gemini/gemini-3.8-flash",
# "openai/gpt-5.6-terra", "deepseek/deepseek-v4-pro". The matching
# provider key must also be set — whatever that provider's standard
# variable is (GEMINI_API_KEY / OPENAI_API_KEY / DEEPSEEK_API_KEY ...).
LITELLM_MODEL=
GEMINI_API_KEY=

# Optional cheaper/faster model for the company-news screening step (is
# this article about the company?). Falls back to LITELLM_MODEL.
NEWS_SCREEN_MODEL=

# ============================================================
# Report data sources (all optional — each one upgrades a card)
# ============================================================
# SEC EDGAR's free API asks callers to identify themselves — any
# descriptive string with a contact; used by the US fundamentals card.
SEC_EDGAR_USER_AGENT=my-app (me@example.com)

# FRED (free): macro-economy card (rates, inflation, jobs).
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub (free tier is fine): company-news card fetches by date range;
# also the first US price-bar source. https://finnhub.io/register
FINNHUB_API_KEY=

# AlphaVantage (free tier 25 calls/day): world-news card fetches by date
# range; also a US price-bar fallback.
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# ============================================================
# Runs
# ============================================================
# How many analyses may run at the same time; the rest wait in line and
# start by themselves. Each run holds price history, news and LLM replies
# in memory while fanning out parallel LLM calls.
TIERED_MAX_CONCURRENT_RUNS=4

# Sizing defaults (pre-fill the run form; the form can override per run)
# TIERED_SIZING_CAPITAL=100000
# TIERED_SIZING_RISK_FRACTION=0.01
# TIERED_SIZING_REWARD_RISK=2

# ============================================================
# Database
# ============================================================
# Leave DATABASE_URL blank to keep everything (run history, transcripts,
# fetched-data caches) in a sqlite file at DATABASE_PATH. Set it to a
# Postgres address (postgresql://user:pass@host/db) to use Postgres
# instead — the same tables, no other change.
DATABASE_URL=
# DATABASE_PATH=./data/stock_analysis.db

# ============================================================
# Rarely needed
# ============================================================
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8000
#
# More knobs exist with sensible defaults and are honored but not listed
# here: sqlite tuning (SQLITE_WAL_ENABLED, SQLITE_BUSY_TIMEOUT_MS) and the
# price-bar vendor order (EFINANCE_PRIORITY, AKSHARE_PRIORITY,
# YFINANCE_PRIORITY). See src/config.py and data_provider/ for the list.
